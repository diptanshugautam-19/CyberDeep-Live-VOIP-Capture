# CyberDEEP Environment Configuration Template
# Copy this file to '.env' and fill in your values. DO NOT commit '.env' to git.

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# IP Intelligence & Threat Enrichment APIs
# Get your token at https://ipinfo.io
IPINFO_TOKEN=your_ipinfo_token_here

# Get your key at https://www.abuseipdb.com
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# Enrichment Settings
ONLINE_ENRICHMENT_ENABLED=true
LIVE_LOOKUP_TIMEOUT_SECONDS=4.0
